#!/usr/bin/env bash
# ==============================================================================
# Spec-Gated Development — pre-commit 훅 (이식 가능 템플릿)
# ==============================================================================
#
# 이 파일은 `docs/methodology/hooks/pre-commit`에 사는 드롭인 템플릿이다.
# 이 방법론 번들을 담고 있는 저장소 자체의 실제 훅으로는 배선돼 있지 않다 —
# 채택(소비) 프로젝트가 아래 방법으로 자기 저장소에 설치해서 쓴다.
#
# ── 설치 방법 ─────────────────────────────────────────────────────────────
#   1) 이 파일을 저장소의 훅 디렉터리로 복사한다(디렉터리명은 자유, 예시는
#      `.githooks`):
#        cp docs/methodology/hooks/pre-commit .githooks/pre-commit
#   2) 실행 권한을 준다:
#        chmod +x .githooks/pre-commit
#   3) git이 이 디렉터리를 훅 경로로 쓰도록 설정한다(저장소마다 1회면 됨,
#      `.git/config`에 저장되고 커밋되지 않으므로 각 팀원이 1회 실행해야 함):
#        git config core.hooksPath .githooks
#   4) (선택) 팀 전체 기본값을 바꾸고 싶으면, 매번 환경변수로 넘기는 대신
#      아래 "설정" 절의 기본값을 이 파일에서 직접 고친다.
#
# ── 이 훅이 강제하는 것 ───────────────────────────────────────────────────
# 어떤 AI 에이전트·스킬 팩이 켜져 있든(혹은 아예 없든, 사람이 직접 커밋하든)
# 커밋 시점에 기계적으로 강제되는 두 가지 불변식:
#   (A) 보호 브랜치(기본 main/master)에 직접 커밋 금지.
#   (B) (설정형) 스테이지된 변경분에 "참조 문서" 노트 또는 검증 마커가 보이지
#       않으면 경고 또는 차단.
#
# ── 설정 (모두 환경변수, 전부 선택) ───────────────────────────────────────
#   SPEC_GATED_PROTECTED_BRANCHES        보호 브랜치 이름(공백 구분).
#                                         기본값: "main master"
#   SPEC_GATED_ALLOW_PROTECTED_COMMIT=1  의도적 예외 — 이번 커밋만 (A)를
#                                         건너뛴다. 예:
#                                           SPEC_GATED_ALLOW_PROTECTED_COMMIT=1 \
#                                             git commit -m "..."
#   SPEC_GATED_TEST_BRANCH               브랜치를 자동 감지하지 않고 이 값을
#                                         쓴다(테스트, 디태치드 HEAD 대응용
#                                         오버라이드).
#   SPEC_GATED_MARKER_MODE               off | warn | block. 기본값: warn.
#   SPEC_GATED_MARKER_PATTERN            마커를 찾는 확장 정규식(grep -E 문법).
#                                         기본값은 아래 DEFAULT_PATTERN 참고.
#   SPEC_GATED_SKIP_MARKER_CHECK=1       이번 커밋만 (B)를 완전히 건너뛴다.
#
# 기본값이 "warn"(차단이 아님)인 이유: 이 파일은 아무 저장소에나 떨어뜨리는
# 드롭인 템플릿이라, 팀이 아직 "참조 문서" 컨벤션을 갖추기 전에 첫 커밋부터
# 막아버리면 바로 삭제당한다. 점진 도입(day-1 최소 → 아플 때 강화)이 이
# 방법론 자체의 원칙이다 — 준비되면 SPEC_GATED_MARKER_MODE=block으로 올린다.
# 반대로 (A) 보호 브랜치 차단은 항상 기본 ON이다 — 부작용 없는 안전장치라
# 점진 도입 대상이 아니다.
#
# ── 알려진 한계 ───────────────────────────────────────────────────────────
# pre-commit 훅은 커밋 "메시지" 내용에 접근할 수 없다 — git이 pre-commit을
# 메시지 수집보다 먼저 실행하기 때문이다(메시지는 commit-msg 훅의 영역). 그래서
# (B)는 커밋 메시지가 아니라 "스테이지된 변경분"(git diff --cached)에서 마커를
# 찾는다. 커밋 메시지 자체까지 강제하고 싶다면, 소비 프로젝트가 이 파일의 (B)
# 로직을 그대로 재사용해 별도 commit-msg 훅을 추가한다.
#
# ── 의존성 ────────────────────────────────────────────────────────────────
# bash + git + grep 뿐. 프로젝트 고유 로직 없음 — 어떤 스택·언어의 저장소에도
# 그대로 드롭인 가능하다.
# ==============================================================================

set -eu

# ---------- (A) 보호 브랜치 직접 커밋 차단 -----------------------------------

if [ "${SPEC_GATED_ALLOW_PROTECTED_COMMIT:-0}" = "1" ]; then
  : # 의도적 예외 — (A)는 통과, (B)는 아래에서 별도로 계속 검사한다.
else
  # 공백으로 단어분리해 순회할 목적이라 의도적으로 따옴표 없이 확장한다(SC2086).
  PROTECTED_BRANCHES="${SPEC_GATED_PROTECTED_BRANCHES:-main master}"

  branch="${SPEC_GATED_TEST_BRANCH:-}"
  if [ -z "$branch" ]; then
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  fi

  is_protected=0
  for b in $PROTECTED_BRANCHES; do
    if [ "$branch" = "$b" ]; then
      is_protected=1
    fi
  done

  if [ "$is_protected" = "1" ]; then
    echo "" >&2
    echo "[pre-commit 훅] 보호 브랜치('$branch')에는 직접 커밋할 수 없습니다." >&2
    echo "" >&2
    echo "작업 브랜치를 먼저 만드세요, 예:" >&2
    echo "  git checkout -b feat/my-change" >&2
    echo "" >&2
    echo "의도적 예외가 필요하면:" >&2
    echo "  SPEC_GATED_ALLOW_PROTECTED_COMMIT=1 git commit -m \"...\"" >&2
    echo "" >&2
    exit 1
  fi
fi

# ---------- (B) (설정형) 참조 문서 / 검증 마커 확인 ---------------------------

MARKER_MODE="${SPEC_GATED_MARKER_MODE:-warn}"
case "$MARKER_MODE" in
  off | warn | block) ;;
  *)
    echo "[pre-commit 훅] SPEC_GATED_MARKER_MODE='$MARKER_MODE'를 알 수 없어 'warn'으로 취급합니다(off|warn|block 중 하나여야 함)." >&2
    MARKER_MODE="warn"
    ;;
esac

if [ "${SPEC_GATED_SKIP_MARKER_CHECK:-0}" = "1" ]; then
  MARKER_MODE="off"
fi

# 병합 커밋에는 마커를 요구하지 않는다.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  MARKER_MODE="off"
fi

if [ "$MARKER_MODE" != "off" ]; then
  DEFAULT_PATTERN='참조 문서|Docs consulted|Planning Gate|검증:|Verified:|Verification:'
  PATTERN="${SPEC_GATED_MARKER_PATTERN:-$DEFAULT_PATTERN}"

  # 스테이지된 변경분 중 실제로 "추가된" 줄만 본다(diff 헤더의 +++ 줄은 제외).
  added_lines="$(git diff --cached 2>/dev/null | grep '^+' | grep -v '^+++' || true)"

  marker_found=0
  if [ -n "$added_lines" ] && printf '%s\n' "$added_lines" | grep -Eq "$PATTERN"; then
    marker_found=1
  fi

  if [ "$marker_found" = "0" ]; then
    echo "" >&2
    echo "[pre-commit 훅] 스테이지된 변경분에서 '참조 문서'/검증 마커를 찾지 못했습니다." >&2
    echo "  패턴: $PATTERN" >&2
    echo "  게이트(재독) 노트나 검증 결과를 이 커밋에 포함하는 것을 권장합니다." >&2
    echo "  이번 커밋만 건너뛰려면: SPEC_GATED_SKIP_MARKER_CHECK=1 git commit ..." >&2
    echo "  이 검사를 계속 끄려면: SPEC_GATED_MARKER_MODE=off" >&2
    echo "" >&2
    if [ "$MARKER_MODE" = "block" ]; then
      exit 1
    fi
  fi
fi

exit 0
